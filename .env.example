# ==========================================
# Billy Platform - Environment Configuration
# ==========================================

# Google Gemini AI API Key (Required for chat assistant and OCR analysis)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (Required for session logs & users collection)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# EmailJS Service Configuration (Required for incident reporting by email)
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id

# Backend API URL (Optional, defaults to http://localhost:5000 in development)
VITE_API_BASE_URL=http://localhost:5000

